{
  "name": "@dudhwala/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared design system for the storefront and admin: tokens/CSS (styles/dw.css), theme + language switches. Source-only; apps compile it (transpilePackages).",
  "exports": {
    "./boot": "./src/boot.ts",
    "./theme": "./src/theme.tsx",
    "./lang": "./src/lang.tsx",
    "./styles.css": "./styles/dw.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@dudhwala/shared": "workspace:^"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "typescript": "5",
    "typescript-eslint": "^8.71.2"
  }
}
