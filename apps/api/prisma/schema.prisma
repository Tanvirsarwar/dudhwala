// Dudhwala — database schema. Source of truth: docs/DATABASE_SCHEMA.md.
// CHECK constraints, partial indexes, pg_trgm and grants live in the raw SQL
// migration (prisma/sql/constraints.sql) because Prisma cannot express them.
// Money: Int poisha. Ids: uuid generated by the API (v7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity & access ─────────────────────────

enum UserKind {
  CUSTOMER
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleCode {
  SUPER_ADMIN
  OUTLET_MANAGER
  OUTLET_STAFF
  DELIVERY_STAFF
  CUSTOMER
}

model User {
  id               String     @id @db.Uuid
  phone            String?    @unique @db.VarChar(14)
  email            String?    @unique @db.Citext
  fullName         String?    @map("full_name") @db.VarChar(120)
  passwordHash     String?    @map("password_hash")
  mfaTotpSecretEnc Bytes?     @map("mfa_totp_secret_enc")
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  /// Last accepted TOTP time step; rejects code replay across API instances.
  mfaLastStep      Int?       @map("mfa_last_step")
  kind             UserKind
  status           UserStatus @default(ACTIVE)
  phoneVerifiedAt  DateTime?  @map("phone_verified_at") @db.Timestamptz
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  roles            UserRole[]
  outletAssignment OutletStaff?      @relation("assignedUser")
  grantedOutlet    OutletStaff[]     @relation("grantedBy")
  sessions         Session[]
  recoveryCodes    MfaRecoveryCode[]
  addresses        Address[]
  cart             Cart?
  orders           Order[]
  riderDeliveries  Delivery[]        @relation("rider")
  auditLogs        AuditLog[]
  privacyRequests  PrivacyRequest[]

  @@map("user")
}

model Role {
  id          String           @id @db.Uuid
  code        RoleCode         @unique
  name        String
  isSystem    Boolean          @default(true) @map("is_system")
  permissions RolePermission[]
  users       UserRole[]
  assignments OutletStaff[]

  @@map("role")
}

model Permission {
  id          String           @id @db.Uuid
  code        String           @unique @db.VarChar(64)
  description String
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

/// Global roles only (SUPER_ADMIN, CUSTOMER). Outlet roles live in OutletStaff.
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_role")
}

/// Each staff member belongs to exactly one outlet (OPEN_DECISIONS C5).
model OutletStaff {
  id               String   @id @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  outletId         String   @map("outlet_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  extraPermissions String[] @default([]) @map("extra_permissions")
  active           Boolean  @default(true)
  grantedById      String   @map("granted_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user      User   @relation("assignedUser", fields: [userId], references: [id])
  outlet    Outlet @relation(fields: [outletId], references: [id])
  role      Role   @relation(fields: [roleId], references: [id])
  grantedBy User   @relation("grantedBy", fields: [grantedById], references: [id])

  @@index([outletId, active])
  @@map("outlet_staff")
}

enum SessionKind {
  CUSTOMER
  STAFF
}

model Session {
  id          String      @id @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  tokenHash   String      @unique @map("token_hash") @db.Char(64)
  kind        SessionKind
  ip          String?     @db.Inet
  userAgent   String?     @map("user_agent") @db.VarChar(512)
  mfaVerified Boolean     @default(false) @map("mfa_verified")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt  DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model MfaRecoveryCode {
  id       String    @id @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_code")
}

enum OtpPurpose {
  LOGIN
  CHECKOUT_VERIFY
}

model OtpChallenge {
  id          String     @id @db.Uuid
  phone       String     @db.VarChar(14)
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") @db.Char(64)
  attempts    Int        @default(0) @db.SmallInt
  maxAttempts Int        @default(5) @map("max_attempts") @db.SmallInt
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz
  ip          String?    @db.Inet
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@map("otp_challenge")
}

// ───────────────────────── Outlets ─────────────────────────

enum OutletStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Outlet {
  id                  String       @id @db.Uuid
  code                String       @unique @db.VarChar(16)
  nameBn              String       @map("name_bn")
  nameEn              String?      @map("name_en")
  addressLine         String       @map("address_line")
  areaId              String?      @map("area_id") @db.Uuid
  phone               String?      @db.VarChar(14)
  email               String?      @db.Citext
  latitude            Decimal?     @db.Decimal(9, 6)
  longitude           Decimal?     @db.Decimal(9, 6)
  status              OutletStatus @default(PAUSED)
  acceptsOnlineOrders Boolean      @default(false) @map("accepts_online_orders")
  autoConfirmOrders   Boolean      @default(false) @map("auto_confirm_orders")
  timezone            String       @default("Asia/Dhaka")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  area           Area?                 @relation(fields: [areaId], references: [id])
  staff          OutletStaff[]
  hours          OutletHours[]
  closures       OutletClosure[]
  inventory      Inventory[]
  movements      StockMovement[]
  transfersOut   StockTransfer[]       @relation("fromOutlet")
  transfersIn    StockTransfer[]       @relation("toOutlet")
  stockCounts    StockCount[]
  zoneRules      OutletZoneRule[]
  slotTemplates  DeliverySlotTemplate[]
  slots          DeliverySlot[]
  orders         Order[]
  deliveries     Delivery[]
  codCollections CodCollection[]
  auditLogs      AuditLog[]
  settings       Setting[]

  @@map("outlet")
}

model OutletHours {
  outletId String   @map("outlet_id") @db.Uuid
  weekday  Int      @db.SmallInt
  opensAt  DateTime @map("opens_at") @db.Time(0)
  closesAt DateTime @map("closes_at") @db.Time(0)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([outletId, weekday, opensAt])
  @@map("outlet_hours")
}

model OutletClosure {
  outletId String   @map("outlet_id") @db.Uuid
  date     DateTime @db.Date
  reason   String
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([outletId, date])
  @@map("outlet_closure")
}

// ───────────────────────── Catalogue ─────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PackUnit {
  ML
  L
  G
  KG
  PCS
}

model Category {
  id        String     @id @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  slug      String     @unique @db.VarChar(80)
  nameBn    String     @map("name_bn")
  nameEn    String?    @map("name_en")
  sortOrder Int        @default(0) @map("sort_order")
  active    Boolean    @default(true)
  parent    Category?  @relation("tree", fields: [parentId], references: [id])
  children  Category[] @relation("tree")
  products  Product[]

  @@map("category")
}

model Product {
  id                String        @id @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  slug              String        @unique @db.VarChar(120)
  nameBn            String        @map("name_bn")
  nameEn            String?       @map("name_en")
  descriptionBn     String?       @map("description_bn")
  descriptionEn     String?       @map("description_en")
  ingredientsBn     String?       @map("ingredients_bn")
  ingredientsEn     String?       @map("ingredients_en")
  allergensBn       String?       @map("allergens_bn")
  allergensEn       String?       @map("allergens_en")
  storageBn         String?       @map("storage_bn")
  storageEn         String?       @map("storage_en")
  shelfLifeBn       String?       @map("shelf_life_bn")
  shelfLifeEn       String?       @map("shelf_life_en")
  status            ProductStatus @default(DRAFT)
  contentApprovedBy String?       @map("content_approved_by") @db.Uuid
  contentApprovedAt DateTime?     @map("content_approved_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  inCollections CollectionItem[]

  @@index([categoryId, status])
  @@index([nameBn(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_bn_trgm")
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_en_trgm")
  @@map("product")
}

/// Single global price per variant (OPEN_DECISIONS B2).
model ProductVariant {
  id             String        @id @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  sku            String        @unique @db.VarChar(40)
  labelBn        String        @map("label_bn")
  labelEn        String?       @map("label_en")
  packSize       Decimal       @map("pack_size") @db.Decimal(10, 3)
  packUnit       PackUnit      @map("pack_unit")
  pricePoisha    Int           @map("price_poisha")
  compareAtPoisha Int?         @map("compare_at_poisha")
  status         ProductStatus @default(DRAFT)
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  product    Product        @relation(fields: [productId], references: [id])
  inventory  Inventory[]
  movements  StockMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  transferLines StockTransferLine[]
  countLines StockCountLine[]

  @@index([productId])
  @@map("product_variant")
}

model ProductImage {
  id         String  @id @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  storageKey String  @map("storage_key")
  altBn      String  @map("alt_bn")
  altEn      String? @map("alt_en")
  width      Int
  height     Int
  sortOrder  Int     @default(0) @map("sort_order")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_image")
}

model Collection {
  id       String           @id @db.Uuid
  slug     String           @unique
  titleBn  String           @map("title_bn")
  titleEn  String?          @map("title_en")
  active   Boolean          @default(false)
  startsAt DateTime?        @map("starts_at") @db.Timestamptz
  endsAt   DateTime?        @map("ends_at") @db.Timestamptz
  sortOrder Int             @default(0) @map("sort_order")
  items    CollectionItem[]

  @@map("collection")
}

model CollectionItem {
  collectionId String     @map("collection_id") @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  sortOrder    Int        @default(0) @map("sort_order")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_item")
}

model Banner {
  id         String    @id @db.Uuid
  titleBn    String    @map("title_bn")
  imageKey   String    @map("image_key")
  altBn      String    @map("alt_bn")
  linkUrl    String?   @map("link_url")
  active     Boolean   @default(false)
  startsAt   DateTime? @map("starts_at") @db.Timestamptz
  endsAt     DateTime? @map("ends_at") @db.Timestamptz
  sortOrder  Int       @default(0) @map("sort_order")
  approvedBy String?   @map("approved_by") @db.Uuid

  @@map("banner")
}

model ContentPage {
  slug        String   @id @db.VarChar(64)
  titleBn     String   @map("title_bn")
  bodyBn      String   @map("body_bn")
  titleEn     String?  @map("title_en")
  bodyEn      String?  @map("body_en")
  version     Int      @default(1)
  published   Boolean  @default(false)
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("content_page")
}

// ───────────────────────── Inventory ─────────────────────────

model Inventory {
  id                String   @id @db.Uuid
  outletId          String   @map("outlet_id") @db.Uuid
  productVariantId  String   @map("product_variant_id") @db.Uuid
  quantityOnHand    Int      @default(0) @map("quantity_on_hand")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  onlineBufferQty   Int      @default(0) @map("online_buffer_qty")
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  isListed          Boolean  @default(false) @map("is_listed")
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  outlet    Outlet          @relation(fields: [outletId], references: [id])
  variant   ProductVariant  @relation(fields: [productVariantId], references: [id])
  movements StockMovement[]

  @@unique([outletId, productVariantId])
  @@map("inventory")
}

enum MovementType {
  RECEIVE
  ADJUST_UP
  ADJUST_DOWN
  RESERVE
  RELEASE
  COMMIT_SALE
  RESTOCK_RETURN
  WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
  RECONCILE
}

/// Append-only. App DB role has no UPDATE/DELETE grant (constraints.sql).
model StockMovement {
  id               String       @id @db.Uuid
  inventoryId      String       @map("inventory_id") @db.Uuid
  outletId         String       @map("outlet_id") @db.Uuid
  productVariantId String       @map("product_variant_id") @db.Uuid
  type             MovementType
  qtyDeltaOnHand   Int          @map("qty_delta_on_hand")
  qtyDeltaReserved Int          @map("qty_delta_reserved")
  onHandAfter      Int          @map("on_hand_after")
  reservedAfter    Int          @map("reserved_after")
  reason           String?
  orderId          String?      @map("order_id") @db.Uuid
  transferId       String?      @map("transfer_id") @db.Uuid
  actorUserId      String?      @map("actor_user_id") @db.Uuid
  actorSystem      String?      @map("actor_system") @db.VarChar(64)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  inventory Inventory      @relation(fields: [inventoryId], references: [id])
  outlet    Outlet         @relation(fields: [outletId], references: [id])
  variant   ProductVariant @relation(fields: [productVariantId], references: [id])
  order     Order?         @relation(fields: [orderId], references: [id])
  transfer  StockTransfer? @relation(fields: [transferId], references: [id])

  @@index([outletId, createdAt(sort: Desc)])
  @@index([inventoryId, createdAt])
  @@index([orderId])
  @@map("stock_movement")
}

enum TransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id            String              @id @db.Uuid
  fromOutletId  String              @map("from_outlet_id") @db.Uuid
  toOutletId    String              @map("to_outlet_id") @db.Uuid
  status        TransferStatus      @default(DRAFT)
  requestedById String              @map("requested_by") @db.Uuid
  approvedById  String?             @map("approved_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  fromOutlet    Outlet              @relation("fromOutlet", fields: [fromOutletId], references: [id])
  toOutlet      Outlet              @relation("toOutlet", fields: [toOutletId], references: [id])
  lines         StockTransferLine[]
  movements     StockMovement[]

  @@map("stock_transfer")
}

model StockTransferLine {
  transferId       String         @map("transfer_id") @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  qty              Int
  receivedQty      Int?           @map("received_qty")
  transfer         StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])

  @@id([transferId, productVariantId])
  @@map("stock_transfer_line")
}

enum StockCountStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model StockCount {
  id            String           @id @db.Uuid
  outletId      String           @map("outlet_id") @db.Uuid
  status        StockCountStatus @default(OPEN)
  startedById   String           @map("started_by") @db.Uuid
  completedById String?          @map("completed_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz
  outlet        Outlet           @relation(fields: [outletId], references: [id])
  lines         StockCountLine[]

  @@index([outletId, status])
  @@map("stock_count")
}

model StockCountLine {
  countId          String         @map("count_id") @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  systemQty        Int            @map("system_qty")
  countedQty       Int?           @map("counted_qty")
  count            StockCount     @relation(fields: [countId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])

  @@id([countId, productVariantId])
  @@map("stock_count_line")
}

// ───────────────────────── Delivery ─────────────────────────

model Area {
  id        String             @id @db.Uuid
  city      String             @default("Sylhet")
  nameBn    String             @map("name_bn")
  nameEn    String?            @map("name_en")
  slug      String             @unique @db.VarChar(80)
  active    Boolean            @default(true)
  zones     DeliveryZoneArea[]
  addresses Address[]
  outlets   Outlet[]
  orders    Order[]
  carts     Cart[]

  @@map("area")
}

model DeliveryZone {
  id     String             @id @db.Uuid
  name   String
  active Boolean            @default(true)
  areas  DeliveryZoneArea[]
  rules  OutletZoneRule[]

  @@map("delivery_zone")
}

model DeliveryZoneArea {
  zoneId String       @map("zone_id") @db.Uuid
  areaId String       @map("area_id") @db.Uuid
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  area   Area         @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([zoneId, areaId])
  @@index([areaId])
  @@map("delivery_zone_area")
}

model OutletZoneRule {
  outletId              String       @map("outlet_id") @db.Uuid
  zoneId                String       @map("zone_id") @db.Uuid
  active                Boolean      @default(false)
  priority              Int          @default(100) @db.SmallInt
  deliveryFeePoisha     Int          @map("delivery_fee_poisha")
  freeDeliveryMinPoisha Int?         @map("free_delivery_min_poisha")
  minOrderPoisha        Int          @default(0) @map("min_order_poisha")
  codEnabled            Boolean      @default(false) @map("cod_enabled")
  codMaxOrderPoisha     Int?         @map("cod_max_order_poisha")
  outlet                Outlet       @relation(fields: [outletId], references: [id])
  zone                  DeliveryZone @relation(fields: [zoneId], references: [id])

  @@id([outletId, zoneId])
  @@map("outlet_zone_rule")
}

model DeliverySlotTemplate {
  id            String         @id @db.Uuid
  outletId      String         @map("outlet_id") @db.Uuid
  weekday       Int            @db.SmallInt
  startsAt      DateTime       @map("starts_at") @db.Time(0)
  endsAt        DateTime       @map("ends_at") @db.Time(0)
  capacity      Int
  cutoffMinutes Int            @map("cutoff_minutes")
  active        Boolean        @default(true)
  outlet        Outlet         @relation(fields: [outletId], references: [id])
  slots         DeliverySlot[]

  @@index([outletId, weekday])
  @@map("delivery_slot_template")
}

enum SlotStatus {
  OPEN
  CLOSED
}

model DeliverySlot {
  id          String                @id @db.Uuid
  outletId    String                @map("outlet_id") @db.Uuid
  templateId  String?               @map("template_id") @db.Uuid
  slotDate    DateTime              @map("slot_date") @db.Date
  startsAt    DateTime              @map("starts_at") @db.Timestamptz
  endsAt      DateTime              @map("ends_at") @db.Timestamptz
  cutoffAt    DateTime              @map("cutoff_at") @db.Timestamptz
  capacity    Int
  bookedCount Int                   @default(0) @map("booked_count")
  status      SlotStatus            @default(OPEN)
  outlet      Outlet                @relation(fields: [outletId], references: [id])
  template    DeliverySlotTemplate? @relation(fields: [templateId], references: [id])
  orders      Order[]

  @@unique([outletId, startsAt])
  @@index([outletId, slotDate])
  @@map("delivery_slot")
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  ARRIVED
  DELIVERED
  FAILED
  RETURNED
}

model Delivery {
  id               String            @id @db.Uuid
  orderId          String            @unique @map("order_id") @db.Uuid
  outletId         String            @map("outlet_id") @db.Uuid
  riderUserId      String?           @map("rider_user_id") @db.Uuid
  status           DeliveryStatus    @default(UNASSIGNED)
  deliveryCodeHash String?           @map("delivery_code_hash")
  assignedById     String?           @map("assigned_by") @db.Uuid
  assignedAt       DateTime?         @map("assigned_at") @db.Timestamptz
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  order            Order             @relation(fields: [orderId], references: [id])
  outlet           Outlet            @relation(fields: [outletId], references: [id])
  rider            User?             @relation("rider", fields: [riderUserId], references: [id])
  attempts         DeliveryAttempt[]
  cod              CodCollection?

  @@index([outletId, status])
  @@index([riderUserId, status])
  @@map("delivery")
}

enum AttemptOutcome {
  DELIVERED
  CUSTOMER_UNAVAILABLE
  WRONG_ADDRESS
  REFUSED
  OTHER
}

model DeliveryAttempt {
  id              String         @id @db.Uuid
  deliveryId      String         @map("delivery_id") @db.Uuid
  attemptNo       Int            @map("attempt_no") @db.SmallInt
  outcome         AttemptOutcome
  note            String?
  proofStorageKey String?        @map("proof_storage_key")
  clientUpdateId  String         @unique @map("client_update_id") @db.VarChar(64)
  recordedById    String         @map("recorded_by") @db.Uuid
  recordedAt      DateTime       @default(now()) @map("recorded_at") @db.Timestamptz
  delivery        Delivery       @relation(fields: [deliveryId], references: [id])

  @@unique([deliveryId, attemptNo])
  @@map("delivery_attempt")
}

enum CodStatus {
  PENDING
  COLLECTED
  HANDED_OVER
  DISCREPANCY
  NOT_COLLECTED
}

model CodCollection {
  id              String    @id @db.Uuid
  deliveryId      String    @unique @map("delivery_id") @db.Uuid
  outletId        String    @map("outlet_id") @db.Uuid
  expectedPoisha  Int       @map("expected_poisha")
  collectedPoisha Int?      @map("collected_poisha")
  status          CodStatus @default(PENDING)
  collectedById   String?   @map("collected_by") @db.Uuid
  collectedAt     DateTime? @map("collected_at") @db.Timestamptz
  receivedById    String?   @map("received_by") @db.Uuid
  receivedAt      DateTime? @map("received_at") @db.Timestamptz
  note            String?
  delivery        Delivery  @relation(fields: [deliveryId], references: [id])
  outlet          Outlet    @relation(fields: [outletId], references: [id])

  @@index([outletId, status])
  @@map("cod_collection")
}

// ───────────────────────── Customers & carts ─────────────────────────

model Address {
  id            String   @id @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String?  @db.VarChar(40)
  recipientName String   @map("recipient_name") @db.VarChar(120)
  phone         String   @db.VarChar(14)
  areaId        String   @map("area_id") @db.Uuid
  line1         String   @db.VarChar(200)
  line2         String?  @db.VarChar(200)
  landmark      String?  @db.VarChar(200)
  instructions  String?  @db.VarChar(300)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area          Area     @relation(fields: [areaId], references: [id])

  @@index([userId])
  @@map("address")
}

model Cart {
  id                 String     @id @db.Uuid
  userId             String?    @unique @map("user_id") @db.Uuid
  anonymousTokenHash String?    @unique @map("anonymous_token_hash") @db.Char(64)
  areaId             String?    @map("area_id") @db.Uuid
  couponCode         String?    @map("coupon_code") @db.Citext
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  expiresAt          DateTime   @map("expires_at") @db.Timestamptz
  user               User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  area               Area?      @relation(fields: [areaId], references: [id])
  items              CartItem[]

  @@index([expiresAt])
  @@map("cart")
}

/// No price stored: carts are always re-priced from product_variant.
model CartItem {
  cartId           String         @map("cart_id") @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  quantity         Int
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])

  @@id([cartId, productVariantId])
  @@map("cart_item")
}

// ───────────────────────── Orders ─────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  CANCELLED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Order {
  id                    String        @id @db.Uuid
  orderNumber           String        @unique @map("order_number") @db.VarChar(16)
  userId                String        @map("user_id") @db.Uuid
  outletId              String        @map("outlet_id") @db.Uuid
  status                OrderStatus
  paymentMethod         PaymentMethod @map("payment_method")
  paymentStatus         PaymentStatus @map("payment_status")
  deliverySlotId        String        @map("delivery_slot_id") @db.Uuid
  slotStartsAt          DateTime      @map("slot_starts_at") @db.Timestamptz
  slotEndsAt            DateTime      @map("slot_ends_at") @db.Timestamptz
  areaId                String        @map("area_id") @db.Uuid
  shipName              String        @map("ship_name")
  shipPhone             String        @map("ship_phone") @db.VarChar(14)
  shipLine1             String        @map("ship_line1")
  shipLine2             String?       @map("ship_line2")
  shipLandmark          String?       @map("ship_landmark")
  shipInstructions      String?       @map("ship_instructions")
  shipAreaNameBn        String        @map("ship_area_name_bn")
  subtotalPoisha        Int           @map("subtotal_poisha")
  discountPoisha        Int           @default(0) @map("discount_poisha")
  deliveryFeePoisha     Int           @map("delivery_fee_poisha")
  totalPoisha           Int           @map("total_poisha")
  currency              String        @default("BDT") @db.Char(3)
  couponId              String?       @map("coupon_id") @db.Uuid
  couponCode            String?       @map("coupon_code")
  idempotencyKey        String        @map("idempotency_key") @db.VarChar(64)
  paymentExpiresAt      DateTime?     @map("payment_expires_at") @db.Timestamptz
  policyVersionAccepted String        @map("policy_version_accepted") @db.VarChar(32)
  placedAt              DateTime?     @map("placed_at") @db.Timestamptz
  confirmedAt           DateTime?     @map("confirmed_at") @db.Timestamptz
  deliveredAt           DateTime?     @map("delivered_at") @db.Timestamptz
  cancelledAt           DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelReason          String?       @map("cancel_reason")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user          User                 @relation(fields: [userId], references: [id])
  outlet        Outlet               @relation(fields: [outletId], references: [id])
  slot          DeliverySlot         @relation(fields: [deliverySlotId], references: [id])
  area          Area                 @relation(fields: [areaId], references: [id])
  coupon        Coupon?              @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  events        OrderStatusEvent[]
  payments      Payment[]
  delivery      Delivery?
  movements     StockMovement[]
  redemption    CouponRedemption?
  notifications NotificationRecord[]

  @@unique([userId, idempotencyKey])
  @@index([outletId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([deliverySlotId])
  @@map("order")
}

/// Snapshot of what was sold; product edits never change history.
model OrderItem {
  id                     String          @id @db.Uuid
  orderId                String          @map("order_id") @db.Uuid
  productVariantId       String?         @map("product_variant_id") @db.Uuid
  productNameBn          String          @map("product_name_bn")
  productNameEn          String?         @map("product_name_en")
  variantLabelBn         String          @map("variant_label_bn")
  sku                    String          @db.VarChar(40)
  unitPricePoisha        Int             @map("unit_price_poisha")
  quantity               Int
  lineTotalPoisha        Int             @map("line_total_poisha")
  discountAllocatedPoisha Int            @default(0) @map("discount_allocated_poisha")
  order                  Order           @relation(fields: [orderId], references: [id])
  variant                ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_item")
}

model OrderStatusEvent {
  id          String       @id @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  actorRole   String       @map("actor_role") @db.VarChar(32)
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  order       Order        @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_event")
}

// ───────────────────────── Payments ─────────────────────────

model Payment {
  id                String        @id @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  method            PaymentMethod
  provider          String?       @db.VarChar(32)
  status            PaymentStatus
  amountPoisha      Int           @map("amount_poisha")
  currency          String        @default("BDT") @db.Char(3)
  merchantTranId    String        @unique @map("merchant_tran_id") @db.VarChar(64)
  providerSessionId String?       @map("provider_session_id")
  providerTranId    String?       @map("provider_tran_id") @db.VarChar(128)
  verifiedAt        DateTime?     @map("verified_at") @db.Timestamptz
  paidAmountPoisha  Int?          @map("paid_amount_poisha")
  refundedPoisha    Int           @default(0) @map("refunded_poisha")
  duplicateCapture  Boolean       @default(false) @map("duplicate_capture")
  failureCode       String?       @map("failure_code")
  failureMessage    String?       @map("failure_message")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  order             Order         @relation(fields: [orderId], references: [id])
  events            PaymentEvent[]
  refunds           Refund[]

  @@unique([provider, providerTranId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payment")
}

enum PaymentEventKind {
  INIT
  CALLBACK
  IPN
  VERIFY_RESPONSE
  REFUND
}

/// Append-only raw evidence from the gateway (secrets stripped).
model PaymentEvent {
  id               String           @id @db.Uuid
  paymentId        String?          @map("payment_id") @db.Uuid
  provider         String           @db.VarChar(32)
  providerEventId  String           @map("provider_event_id") @db.VarChar(128)
  kind             PaymentEventKind
  signatureValid   Boolean?         @map("signature_valid")
  payload          Json
  receivedAt       DateTime         @default(now()) @map("received_at") @db.Timestamptz
  processedAt      DateTime?        @map("processed_at") @db.Timestamptz
  processingResult String?          @map("processing_result")
  payment          Payment?         @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_event")
}

enum RefundStatus {
  REQUESTED
  SUBMITTED
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amountPoisha     Int          @map("amount_poisha")
  reason           String
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?      @map("provider_refund_id")
  idempotencyKey   String       @unique @map("idempotency_key") @db.VarChar(64)
  requestedById    String       @map("requested_by") @db.Uuid
  approvedById     String?      @map("approved_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  payment          Payment      @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refund")
}

// ───────────────────────── Coupons ─────────────────────────

enum CouponType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

model Coupon {
  id                    String             @id @db.Uuid
  code                  String             @unique @db.Citext
  type                  CouponType
  value                 Int
  maxDiscountPoisha     Int?               @map("max_discount_poisha")
  minOrderPoisha        Int                @default(0) @map("min_order_poisha")
  startsAt              DateTime?          @map("starts_at") @db.Timestamptz
  endsAt                DateTime?          @map("ends_at") @db.Timestamptz
  usageLimitTotal       Int?               @map("usage_limit_total")
  usageLimitPerCustomer Int?               @map("usage_limit_per_customer")
  usedCount             Int                @default(0) @map("used_count")
  outletIds             String[]           @map("outlet_ids") @db.Uuid
  firstOrderOnly        Boolean            @default(false) @map("first_order_only")
  active                Boolean            @default(false)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  orders                Order[]
  redemptions           CouponRedemption[]

  @@map("coupon")
}

enum RedemptionStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

model CouponRedemption {
  id             String           @id @db.Uuid
  couponId       String           @map("coupon_id") @db.Uuid
  orderId        String           @unique @map("order_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  discountPoisha Int              @map("discount_poisha")
  status         RedemptionStatus @default(RESERVED)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  coupon         Coupon           @relation(fields: [couponId], references: [id])
  order          Order            @relation(fields: [orderId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_redemption")
}

// ───────────────────────── Cross-cutting ─────────────────────────

/// Append-only. App DB role has no UPDATE/DELETE grant (constraints.sql).
model AuditLog {
  id          String   @id @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String   @map("actor_role") @db.VarChar(32)
  outletId    String?  @map("outlet_id") @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(48)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  before      Json?
  after       Json?
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor       User?    @relation(fields: [actorUserId], references: [id])
  outlet      Outlet?  @relation(fields: [outletId], references: [id])

  @@index([outletId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_log")
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

model NotificationRecord {
  id                String              @id @db.Uuid
  channel           NotificationChannel
  template          String              @db.VarChar(64)
  toMasked          String              @map("to_masked") @db.VarChar(64)
  toEnc             Bytes               @map("to_enc")
  orderId           String?             @map("order_id") @db.Uuid
  status            NotificationStatus  @default(QUEUED)
  attempts          Int                 @default(0) @db.SmallInt
  nextAttemptAt     DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz
  providerMessageId String?             @map("provider_message_id")
  lastError         String?             @map("last_error")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  order             Order?              @relation(fields: [orderId], references: [id])

  @@index([status, nextAttemptAt])
  @@map("notification_record")
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Job {
  id        String    @id @db.Uuid
  type      String    @db.VarChar(64)
  payload   Json
  runAt     DateTime  @default(now()) @map("run_at") @db.Timestamptz
  attempts  Int       @default(0) @db.SmallInt
  status    JobStatus @default(PENDING)
  lockedAt  DateTime? @map("locked_at") @db.Timestamptz
  lockedBy  String?   @map("locked_by") @db.VarChar(64)
  lastError String?   @map("last_error")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, runAt])
  @@map("job")
}

enum SettingScope {
  GLOBAL
  OUTLET
}

model Setting {
  id          String       @id @db.Uuid
  key         String       @db.VarChar(96)
  scope       SettingScope
  outletId    String?      @map("outlet_id") @db.Uuid
  value       Json
  updatedById String?      @map("updated_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  outlet      Outlet?      @relation(fields: [outletId], references: [id])

  @@unique([key, outletId])
  @@map("setting")
}

model IdempotencyRecord {
  key          String   @db.VarChar(64)
  principal    String   @db.VarChar(80)
  route        String   @db.VarChar(120)
  requestHash  String   @map("request_hash") @db.Char(64)
  responseBody Json?    @map("response_body")
  statusCode   Int?     @map("status_code") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([key, principal, route])
  @@index([createdAt])
  @@map("idempotency_record")
}

/// Fixed-window rate-limit counters shared by all API instances (SECURITY_REVIEW §5).
model RateLimitBucket {
  key         String   @db.VarChar(160)
  windowStart DateTime @map("window_start") @db.Timestamptz
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_bucket")
}

enum FakeGatewayStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

/// Ledger of the built-in payment SIMULATOR (PAYMENTS_PROVIDER=fake). Plays the
/// role of a gateway's own records in development, tests and demo staging.
/// Refused in production by env validation.
model FakeGatewayTxn {
  sessionId      String            @id @map("session_id") @db.VarChar(64)
  merchantTranId String            @unique @map("merchant_tran_id") @db.VarChar(64)
  providerTranId String            @unique @map("provider_tran_id") @db.VarChar(64)
  amountPoisha   Int               @map("amount_poisha")
  currency       String            @default("BDT") @db.Char(3)
  status         FakeGatewayStatus @default(INITIATED)
  refundedPoisha Int               @default(0) @map("refunded_poisha")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("fake_gateway_txn")
}

enum PrivacyRequestKind {
  DELETE
}

enum PrivacyRequestStatus {
  REQUESTED
  COMPLETED
  REJECTED
}

/// Customer account-deletion requests (OPEN_DECISIONS F6). Processed by a Super Admin.
model PrivacyRequest {
  id            String               @id @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  kind          PrivacyRequestKind
  status        PrivacyRequestStatus @default(REQUESTED)
  note          String?              @db.VarChar(500)
  processedById String?              @map("processed_by") @db.Uuid
  processedAt   DateTime?            @map("processed_at") @db.Timestamptz
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  user          User                 @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("privacy_request")
}
