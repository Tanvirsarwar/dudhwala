// Dudhwala — database schema (Phase 2, compact V2 model).
// CHECK constraints, partial indexes, append-only triggers live in
// prisma/sql/constraints.sql (Prisma cannot express them).
// Money: Int poisha. Ids: uuid generated by the API.
// Source of truth for the contract: docs/ADMIN_AND_API_CONTRACT.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity & access ─────────────────────────

enum UserKind {
  CUSTOMER
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// ADMIN: full access, two-factor required. MANAGER: read-only view of orders and product counts.
enum StaffRole {
  ADMIN
  MANAGER
}

model User {
  id               String     @id @db.Uuid
  phone            String?    @unique @db.VarChar(14)
  email            String?    @unique @db.Citext
  fullName         String?    @map("full_name") @db.VarChar(120)
  passwordHash     String?    @map("password_hash")
  mfaTotpSecretEnc Bytes?     @map("mfa_totp_secret_enc")
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  /// Last accepted TOTP time step; rejects code replay across API instances.
  mfaLastStep      Int?       @map("mfa_last_step")
  kind             UserKind
  staffRole        StaffRole? @map("staff_role")
  status           UserStatus @default(ACTIVE)
  phoneVerifiedAt  DateTime?  @map("phone_verified_at") @db.Timestamptz
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions      Session[]
  recoveryCodes MfaRecoveryCode[]
  cart          Cart?
  orders        Order[]
  auditLogs     AuditLog[]

  @@map("user")
}

enum SessionKind {
  CUSTOMER
  STAFF
}

model Session {
  id          String      @id @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  tokenHash   String      @unique @map("token_hash") @db.Char(64)
  kind        SessionKind
  ip          String?     @db.Inet
  userAgent   String?     @map("user_agent") @db.VarChar(512)
  mfaVerified Boolean     @default(false) @map("mfa_verified")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt  DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model MfaRecoveryCode {
  id       String    @id @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_code")
}

model OtpChallenge {
  id          String    @id @db.Uuid
  phone       String    @db.VarChar(14)
  codeHash    String    @map("code_hash") @db.Char(64)
  attempts    Int       @default(0) @db.SmallInt
  maxAttempts Int       @default(5) @map("max_attempts") @db.SmallInt
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  ip          String?   @db.Inet
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@map("otp_challenge")
}

// ───────────────────────── Outlets ─────────────────────────

enum OutletStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Outlet {
  id          String       @id @db.Uuid
  code        String       @unique @db.VarChar(32)
  nameBn      String       @map("name_bn")
  nameEn      String?      @map("name_en")
  addressLine String       @map("address_line")
  phone       String?      @db.VarChar(20)
  status      OutletStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  hours     OutletHours[]
  inventory Inventory[]
  movements StockMovement[]
  orders    Order[]

  @@map("outlet")
}

/// Opening hours per weekday (0 = Sunday … 6 = Saturday), Asia/Dhaka local time. No row = closed that day.
model OutletHours {
  outletId String   @map("outlet_id") @db.Uuid
  weekday  Int      @db.SmallInt
  opensAt  DateTime @map("opens_at") @db.Time(0)
  closesAt DateTime @map("closes_at") @db.Time(0)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([outletId, weekday])
  @@map("outlet_hours")
}

// ───────────────────────── Catalogue ─────────────────────────

enum OuterCityStatus {
  APPROVED
  DISABLED
  PENDING_VERIFICATION
  PENDING_CONFIRMATION
}

model Category {
  id        String    @id @db.Uuid
  slug      String    @unique @db.VarChar(80)
  nameBn    String    @map("name_bn")
  nameEn    String?   @map("name_en")
  sortOrder Int       @default(0) @map("sort_order")
  active    Boolean   @default(true)
  products  Product[]

  @@map("category")
}

model Product {
  id              String           @id @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  slug            String           @unique @db.VarChar(120)
  nameBn          String           @map("name_bn")
  nameEn          String?          @map("name_en")
  /// false = the Bangla/English name came from an unverified source list and still needs the owner's confirmation.
  nameVerified    Boolean          @default(false) @map("name_verified")
  /// null = category default (see ELIGIBILITY_RULES in packages/shared).
  outerCityStatus OuterCityStatus? @map("outer_city_status")
  active          Boolean          @default(false)
  descriptionBn   String?          @map("description_bn")
  ingredientsBn   String?          @map("ingredients_bn")
  allergensBn     String?          @map("allergens_bn")
  storageBn       String?          @map("storage_bn")
  shelfLifeBn     String?          @map("shelf_life_bn")
  /// Object-storage key of the single product photo (re-encoded WebP).
  imageKey        String?          @map("image_key")
  imageWidth      Int?             @map("image_width")
  imageHeight     Int?             @map("image_height")
  imageVersion    Int              @default(0) @map("image_version")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@index([categoryId, active])
  @@map("product")
}

/// pricePoisha null = price not set yet: the item is shown as "price to be confirmed" and cannot be ordered.
model ProductVariant {
  id              String   @id @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  labelBn         String   @default("") @map("label_bn")
  labelEn         String?  @map("label_en")
  pricePoisha     Int?     @map("price_poisha")
  compareAtPoisha Int?     @map("compare_at_poisha")
  /// Per-order quantity cap (a technical limit, not stock).
  maxQty          Int      @default(20) @map("max_qty")
  /// false = stock is not counted for this variant (explicit admin choice); true = orders are limited by Inventory rows.
  trackStock      Boolean  @default(true) @map("track_stock")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory[]
  movements  StockMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variant")
}

// ───────────────────────── Inventory ─────────────────────────

model Inventory {
  id               String   @id @db.Uuid
  outletId         String   @map("outlet_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  outlet    Outlet          @relation(fields: [outletId], references: [id])
  variant   ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([outletId, productVariantId])
  @@map("inventory")
}

enum MovementType {
  SET
  RESERVE
  RELEASE
  COMMIT_SALE
}

/// Append-only (trigger in constraints.sql).
model StockMovement {
  id               String       @id @db.Uuid
  inventoryId      String       @map("inventory_id") @db.Uuid
  outletId         String       @map("outlet_id") @db.Uuid
  productVariantId String       @map("product_variant_id") @db.Uuid
  type             MovementType
  qtyDeltaOnHand   Int          @map("qty_delta_on_hand")
  qtyDeltaReserved Int          @map("qty_delta_reserved")
  onHandAfter      Int          @map("on_hand_after")
  reservedAfter    Int          @map("reserved_after")
  reason           String?
  orderId          String?      @map("order_id") @db.Uuid
  actorUserId      String?      @map("actor_user_id") @db.Uuid
  actorSystem      String?      @map("actor_system") @db.VarChar(64)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  inventory Inventory      @relation(fields: [inventoryId], references: [id])
  outlet    Outlet         @relation(fields: [outletId], references: [id])
  variant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [orderId], references: [id])

  @@index([outletId, createdAt(sort: Desc)])
  @@index([inventoryId, createdAt])
  @@index([orderId])
  @@map("stock_movement")
}

// ───────────────────────── Cart ─────────────────────────

model Cart {
  id                 String     @id @db.Uuid
  userId             String?    @unique @map("user_id") @db.Uuid
  anonymousTokenHash String?    @unique @map("anonymous_token_hash") @db.Char(64)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  expiresAt          DateTime   @map("expires_at") @db.Timestamptz
  user               User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              CartItem[]

  @@index([expiresAt])
  @@map("cart")
}

/// No price stored: carts are always re-priced from product_variant.
model CartItem {
  cartId           String         @map("cart_id") @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  quantity         Int
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@id([cartId, productVariantId])
  @@map("cart_item")
}

// ───────────────────────── Orders ─────────────────────────

enum FulfilmentMethod {
  HOME_DELIVERY
  EXPRESS_PICKUP
  BULK_ORDER
}

enum DeliveryZone {
  IN_CITY
  OUTER_CITY
}

/// Per-method flows are enforced by packages/shared ORDER_STATUS_FLOW; a CHECK keeps invalid pairs out of the table.
enum OrderStatus {
  PLACED
  PICKUP_REQUESTED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  READY_FOR_COLLECTION
  DELIVERED
  PICKED_UP
  COLLECTED
  CANCELLED
}

/// Cash on delivery is the only payment method (no online gateway).
enum PaymentMethod {
  COD
}

/// UNPAID until staff record that the cash was collected. Separate from the order's delivery status.
enum PaymentStatus {
  UNPAID
  PAID
}

model Order {
  id             String           @id @db.Uuid
  orderNumber    String           @unique @map("order_number") @db.VarChar(16)
  userId         String           @map("user_id") @db.Uuid
  /// Outlet that fulfils (dispatches / hands over) the order and whose stock is reserved.
  outletId       String           @map("outlet_id") @db.Uuid
  method         FulfilmentMethod
  zone           DeliveryZone?
  status         OrderStatus
  paymentMethod  PaymentMethod    @default(COD) @map("payment_method")
  paymentStatus  PaymentStatus    @default(UNPAID) @map("payment_status")
  paidAt         DateTime?        @map("paid_at") @db.Timestamptz
  paidById       String?          @map("paid_by") @db.Uuid
  contactName    String           @map("contact_name") @db.VarChar(80)
  contactPhone   String           @map("contact_phone") @db.VarChar(14)
  addressLine1   String?          @map("address_line1") @db.VarChar(300)
  addressLandmark String?         @map("address_landmark") @db.VarChar(120)
  pickupAt       DateTime?        @map("pickup_at") @db.Timestamptz
  subtotalPoisha Int              @map("subtotal_poisha")
  deliveryFeePoisha Int           @default(0) @map("delivery_fee_poisha")
  totalPoisha    Int              @map("total_poisha")
  currency       String           @default("BDT") @db.Char(3)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(64)
  /// Showroom (bulk-size) thresholds in force when the order was placed (audit trail).
  bulkRuleSnapshot Json?          @map("bulk_rule_snapshot")
  cancelReason   String?          @map("cancel_reason")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user      User               @relation(fields: [userId], references: [id])
  outlet    Outlet             @relation(fields: [outletId], references: [id])
  items     OrderItem[]
  events    OrderStatusEvent[]
  movements StockMovement[]

  @@unique([userId, idempotencyKey])
  @@index([outletId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([paymentStatus, createdAt(sort: Desc)], map: "order_payment_status_idx")
  @@map("order")
}

/// Snapshot of what was sold; product edits never change history.
model OrderItem {
  id               String          @id @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  productVariantId String?         @map("product_variant_id") @db.Uuid
  productSlug      String          @map("product_slug") @db.VarChar(120)
  productNameBn    String          @map("product_name_bn")
  productNameEn    String?         @map("product_name_en")
  variantLabelBn   String          @map("variant_label_bn")
  unitPricePoisha  Int             @map("unit_price_poisha")
  quantity         Int
  lineTotalPoisha  Int             @map("line_total_poisha")
  order            Order           @relation(fields: [orderId], references: [id])
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_item")
}

/// Append-only (trigger in constraints.sql).
model OrderStatusEvent {
  id          String       @id @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  actorRole   String       @map("actor_role") @db.VarChar(32)
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  order       Order        @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_event")
}

// ───────────────────────── Platform ─────────────────────────

model AuditLog {
  id          String   @id @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String   @map("actor_role") @db.VarChar(32)
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(48)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  before      Json?
  after       Json?
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

/// Global key/value settings (hours, bulk rule, outlet ids). See src/settings/settings.registry.ts.
model Setting {
  key         String   @id @db.VarChar(96)
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("setting")
}

model IdempotencyRecord {
  key          String   @db.VarChar(64)
  principal    String   @db.VarChar(80)
  route        String   @db.VarChar(120)
  requestHash  String   @map("request_hash") @db.Char(64)
  responseBody Json?    @map("response_body")
  statusCode   Int?     @map("status_code") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([key, principal, route])
  @@index([createdAt])
  @@map("idempotency_record")
}

/// Fixed-window rate-limit counters shared by all API instances.
model RateLimitBucket {
  key         String   @db.VarChar(160)
  windowStart DateTime @map("window_start") @db.Timestamptz
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_bucket")
}
