{
  "name": "@dudhwala/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "db:dev-bootstrap": "node scripts/dev-ddl.mjs",
    "cli:create-staff": "node dist/cli/create-staff.js",
    "cli:setup": "node dist/cli/setup.js",
    "cli:import-catalogue": "node dist/cli/import-catalogue.js",
    "cli:reset-mfa": "node dist/cli/reset-mfa.js",
    "cli:reset-mfa:dev": "tsx src/cli/reset-mfa.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/prisma-schema-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@dudhwala/shared": "workspace:^",
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-express": "11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "5",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "uuid": "^14.0.3",
    "zod": "3"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "engines": {
    "node": "22.x"
  }
}
