# Storefront (apps/web). Copy to .env.local for development. Only NEXT_PUBLIC_* values reach the browser: never put secrets here.

# API base URL as the BROWSER sees it.
#   "/v1"                      same-origin mode (recommended): the storefront proxies /v1/* to API_PROXY_TARGET, so cookies stay first-party
#   "https://api.example.com/v1"  direct mode (needs CORS + cross-site cookie settings on the API)
# Required for production builds (the build fails without it instead of silently calling localhost).
NEXT_PUBLIC_API_URL=/v1

# Same-origin mode only: where /v1/* is forwarded (bare https origin of the API; http only for localhost checks).
API_PROXY_TARGET=https://api.example.com
# Server-side rendering calls the API directly; defaults to API_PROXY_TARGET + NEXT_PUBLIC_API_URL when unset.
# API_INTERNAL_URL=https://api.example.com/v1

# Extra image origins allowed by the CSP, space separated, bare https origins only (media CDN / storage).
# NEXT_PUBLIC_MEDIA_ORIGINS=https://media.example.com

# Search engines: set to "true" only on the real public site.
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Yellow notice bar on staging/preview deployments.
# NEXT_PUBLIC_PREVIEW_LABEL=Staging — test data only

# DEMO ONLY: never set in production. Switches on the local-demo behaviours (zone strip, demo checkout, demo "My orders", About story, PETRA credit, no CDN caching of the catalogue).
# NEXT_PUBLIC_DEMO_BRANDING=1
