# Admin/manager panel (apps/admin). Only NEXT_PUBLIC_* values reach the browser: never put secrets here.

# Same meaning as in apps/web/.env.example. Required for production builds.
NEXT_PUBLIC_API_URL=/v1
API_PROXY_TARGET=https://api.example.com

# Image origins allowed by the CSP (product photos served from a media CDN), bare https origins, space separated.
# NEXT_PUBLIC_MEDIA_ORIGINS=https://media.example.com

# Optional "View shop" link in the sidebar and on product pages (public URL of the storefront).
# NEXT_PUBLIC_STOREFRONT_URL=https://shop.example.com

# NEXT_PUBLIC_PREVIEW_LABEL=Staging — test data only

# DEMO ONLY: never set in production.
# NEXT_PUBLIC_DEMO_BRANDING=1
# NEXT_PUBLIC_DEMO_ADMIN_LOGIN=...      (text shown on the login pages by the local demo launcher)
# NEXT_PUBLIC_DEMO_MANAGER_LOGIN=...
