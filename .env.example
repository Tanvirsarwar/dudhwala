# Dudhwala environment variables — names and descriptions only, no real values.
# The API validates these at start-up (apps/api/src/config/env.ts) and refuses to
# start with unsafe combinations (e.g. the payment simulator in production).
# Local development: copy the API block to apps/api/.env.
# Staging and production: set them in the hosting platform's secret store.
# Never reuse a value between staging and production.

# ───────────────────────── API (apps/api) ─────────────────────────

NODE_ENV=development                  # development | staging | production
API_PORT=4000
WEB_ORIGIN=http://localhost:3000      # storefront origin: CORS allow-list, redirect target after payment
ADMIN_ORIGIN=http://localhost:3001    # admin origin: CORS allow-list
API_PUBLIC_URL=http://localhost:4000  # public API base; gateway IPN/return URLs are built from it. https outside development.
LOG_LEVEL=info                        # debug | info | warn | error

# Database (managed PostgreSQL 16+ in staging/production)
DATABASE_URL=postgresql://dw:dw_local_only@127.0.0.1:5432/dudhwala_dev

# Secrets — generate each with: openssl rand -base64 32
SESSION_SECRET=                       # ≥ 32 chars; signs CSRF tokens and checkout quote hashes
OTP_HMAC_KEY=                         # ≥ 32 chars; HMAC key for stored OTP and recovery codes
DATA_ENCRYPTION_KEY=                  # exactly 32 bytes, base64; AES-256-GCM for TOTP secrets and SMS recipients
DATA_ENCRYPTION_KEY_ID=k1             # stored with each ciphertext; change when rotating the key

# Product and banner images
MEDIA_STORAGE=local                   # local (development only) | s3 (required in staging/production)
MEDIA_DIR=./var/media                 # local storage folder (development)
MEDIA_PUBLIC_URL=                     # public base URL of the bucket/CDN, e.g. https://media.example.com
STORAGE_ENDPOINT=                     # S3-compatible endpoint (Cloudflare R2, DigitalOcean Spaces, AWS S3, …)
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Online payment (OPEN_DECISIONS E1)
PAYMENTS_PROVIDER=fake                # fake = built-in simulator (development; staging only with ALLOW_PAYMENT_SIMULATOR) | sslcommerz
ALLOW_PAYMENT_SIMULATOR=false         # staging: set true to demo with the simulator before merchant approval
PAYMENTS_WEBHOOK_SECRET=              # simulator only: ≥ 32 chars outside development
SSLCOMMERZ_STORE_ID=                  # from the SSLCOMMERZ merchant panel (sandbox id for staging)
SSLCOMMERZ_STORE_PASSWORD=            # store password (secret)
SSLCOMMERZ_LIVE=false                 # true only in production with live credentials; must be false elsewhere

# SMS (OPEN_DECISIONS F2)
SMS_PROVIDER=log                      # log = print to console (development only) | http = Bangladeshi bulk-SMS HTTP API
SMS_HTTP_URL=                         # provider endpoint (https)
SMS_HTTP_METHOD=POST                  # GET | POST (form-encoded)
SMS_HTTP_STATIC_PARAMS=               # provider's fixed parameters as a query string, e.g. api_key=…&senderid=…&type=unicode (secret)
SMS_HTTP_TO_PARAM=number              # name of the recipient parameter
SMS_HTTP_TEXT_PARAM=message           # name of the message parameter
SMS_HTTP_PHONE_FORMAT=880             # e164 (+8801…) | 880 (8801…) | 0 (01…)
SMS_HTTP_SUCCESS_PATTERN=.            # regex the provider's response must match to count as sent
SMS_DAILY_CAP=500                     # hard stop on order SMS per day (OTP is limited separately per phone/IP)
ENABLE_DEV_OUTBOX=false               # development only: exposes sent SMS (incl. OTP) at /v1/dev/sms for E2E tests

# ───────────────────── Storefront and admin (apps/web, apps/admin) ─────────────────────
# NEXT_PUBLIC_* are compiled into the browser bundle at build time (one build per environment).
# Never put secrets in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_MEDIA_ORIGINS=            # space-separated image origins allowed by the CSP (media CDN; demo: https://wellfoodonline.com)
NEXT_PUBLIC_ALLOW_INDEXING=false      # storefront: true only for the public production site (robots/noindex)
API_INTERNAL_URL=                     # storefront server-side fetches; defaults to NEXT_PUBLIC_API_URL (set to a private URL if the platform has one)
